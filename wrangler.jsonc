{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wholefoods-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  // global_fetch_strictly_public is required for OAuth Client ID Metadata Documents (SSRF protection).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [{ "name": "SHOPPER", "class_name": "Shopper" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Shopper"] }],
  // No id: wrangler creates the namespace on the first deploy and keeps it linked afterwards.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }]
  // Secrets (npx wrangler secret put <NAME>):
  //   OWNER_PASSWORD  the password you type to approve an MCP client and to open the sign-in page
  //   SECRET_KEY      32+ random bytes, base64. Encrypts the stored Amazon cookies and signs the owner session.
}
